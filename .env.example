# Copy to backend/.env. Every value has a working local default — this file
# only needs to change when pointing at real infrastructure.

LEADRANK_ENV=local

# sqlite for local/demo. Production: postgresql+psycopg://user:pass@host:5432/leadrank
LEADRANK_DATABASE_URL=sqlite:///./leadrank.db

# Empty = in-process cache. Production: redis://default:pass@host:6379
LEADRANK_REDIS_URL=

# offline = replay bundled fixtures (app/data/scan_fixtures.json), no egress needed.
# live = fetch real sites, respecting robots.txt, rate limited.
LEADRANK_SCAN_MODE=offline
LEADRANK_SCAN_CONCURRENCY=8
LEADRANK_SCAN_TIMEOUT_SECONDS=5.0

# Optional. Only rewrites the one-sentence narrative — never touches the score.
# Leave blank to ship the deterministic template sentence.
LEADRANK_ANTHROPIC_API_KEY=

# Optional. Enables POST /api/v1/runs/search (score a SaaSquatch search result
# set before a credit is spent, instead of after a CSV export). Leave blank
# and that route returns 400 — see app/core/sources.py.
LEADRANK_SAASQUATCH_API_KEY=

LEADRANK_CORS_ORIGINS=http://localhost:3000
